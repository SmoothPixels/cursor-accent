#!/bin/bash
# Configure and reapply the accent-following cursor.
#
# Usage:
#   cursor-accent follow                 # go back to following the active theme
#   cursor-accent fixed '#rrggbb'        # stop following the theme, use one color
#   cursor-accent default                # turn this off, use the system default cursor
#   cursor-accent shape <shape>          # modern (default), original, macos, macos-tailless,
#                                        #   dart, retro, crosshair, dot
#   cursor-accent shapes                 # list the valid shapes
#   cursor-accent settings               # open the settings window
#   cursor-accent status                 # show current config
set -euo pipefail
PLUGIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
STATE_DIR="$HOME/.local/state/cursor-accent"
CONFIG="$STATE_DIR/config.json"

read_config() {
  [[ -f $CONFIG ]] && cat "$CONFIG" || echo '{"mode":"theme","shape":"modern","fixed_color":"#F25623"}'
}

write_and_apply() {
  mkdir -p "$STATE_DIR"
  echo "$1" > "$CONFIG"
  python3 "$PLUGIN_DIR/recolor.py" "$(omarchy-theme-current 2>/dev/null || echo unknown)"
}

case "${1:-}" in
  follow)
    write_and_apply "$(read_config | jq '.mode = "theme"')"
    ;;
  fixed)
    [[ -n ${2:-} ]] || { echo "Usage: cursor-accent fixed '#rrggbb'" >&2; exit 1; }
    write_and_apply "$(read_config | jq --arg c "$2" '.mode = "fixed" | .fixed_color = $c')"
    ;;
  default)
    write_and_apply "$(read_config | jq '.mode = "off"')"
    ;;
  shape)
    shapes=$(python3 "$PLUGIN_DIR/recolor.py" --list-shapes)
    grep -qxF -- "${2:-}" <<<"$shapes" || { echo "Usage: cursor-accent shape $(paste -sd'|' <<<"$shapes")" >&2; exit 1; }
    write_and_apply "$(read_config | jq --arg s "$2" '.shape = $s')"
    ;;
  shapes)
    python3 "$PLUGIN_DIR/recolor.py" --list-shapes
    ;;
  settings)
    omarchy-shell shell summon io.github.smoothpixels.cursor-accent
    ;;
  status)
    read_config | jq .
    ;;
  *)
    echo "Usage: cursor-accent follow | fixed '#rrggbb' | default | shape <shape> | shapes | settings | status" >&2
    exit 1
    ;;
esac
